# токен от @BotFather
BOT_TOKEN=
# твой telegram id через запятую (для /stats и /refund)
ADMIN_IDS=
SUPPORT_CONTACT=@твой_ник
DB_PATH=genbot.sqlite3

# провайдеры: mock (тест без затрат) | mage | vilva | fal | openrouter (только картинки)
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
MAGE_API_KEY=
VILVA_API_KEY=
FAL_KEY=
OPENROUTER_API_KEY=

# mage: пути REST сверить с docs.mage.space/api/overview
# MAGE_BASE_URL=https://api.mage.space
# MAGE_SUBMIT_PATH=/v1/generate
# MAGE_STATUS_PATH=/v1/requests/{id}
# картинки: gpt_image_2 / gpt-image-2.5-flare (~9 gems), guava / guava-2 (~36), mango / mango-v3s (~55)
# MAGE_IMAGE_ARCH=gpt_image_2
# MAGE_IMAGE_MODEL=gpt-image-2.5-flare
# видео: cherry / cherry-mini (~240 gems), lemon / lemon (~245)
# MAGE_VIDEO_ARCH=cherry
# MAGE_VIDEO_MODEL=cherry-mini

# vilva: mcp-сервер, модель можно не указывать (возьмёт свою по умолчанию)
# VILVA_MCP_URL=https://api.vilva.ai/mcp
# VILVA_IMAGE_MODEL=
# VILVA_VIDEO_MODEL=

# модели (можно не трогать)
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video
# FAL_I2V_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# цены в кредитах и бонус новичку
IMAGE_COST=1
VIDEO_COST=15
FREE_CREDITS=3
