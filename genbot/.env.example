# токен от @BotFather
BOT_TOKEN=
# название сервиса в приветствии и справке
BOT_BRAND=Mirage
# твой telegram id через запятую (для /stats, /refund и уведомлений о балансе провайдеров)
ADMIN_IDS=
SUPPORT_CONTACT=@твой_ник
DB_PATH=genbot.sqlite3

# ключи провайдеров: какие заданы, те модели и появятся в боте
MAGE_API_KEY=
VILVA_API_KEY=
# MAGE_BASE_URL=https://api.mage.space/v1
# VILVA_MCP_URL=https://api.vilva.ai/mcp

# экономика: цены считаются через $ себестоимости
# Mage: 10 000 gems = $10 → 0.001 $ за gem
MAGE_USD_PER_GEM=0.001
# Vilva: 4 000 кредитов = $21 → 0.00525 $ за кредит
VILVA_USD_PER_CREDIT=0.00525
# сколько $ приносит 1 кредит бота (пакет 100⭐ = 20 кр, 1000⭐ ≈ $13.3)
CREDIT_USD=0.0665
# наценка поверх себестоимости
MARKUP=2

# модели по умолчанию (ключи из /settings: mage:<model_id> или vilva:<id>)
DEFAULT_IMAGE_MODEL=mage:gpt-image-2.5-flare
DEFAULT_VIDEO_MODEL=mage:lemon
# бюджеты агента Vilva в кредитах бота
AGENT_BUDGETS=50,150,400
FREE_CREDITS=3
# USE_MOCK=1 — добавить тестовые модели без затрат
